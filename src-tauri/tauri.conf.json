{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DreamCanvas",
  "version": "0.4.0",
  "identifier": "com.imagegenerator.dreamcanvas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DreamCanvas — AI Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "resources": {
      "../scripts/worker.py": "worker.py",
      "../scripts/requirements.txt": "requirements.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
